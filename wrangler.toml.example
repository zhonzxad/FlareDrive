# FlareDrive Wrangler Configuration
# See: https://developers.cloudflare.com/pages/functions/wrangler-configuration/

name = "flare-drive"
compatibility_date = "2024-01-01"
pages_build_output_dir = "./build"

# R2 Bucket binding
# Replace "BUCKET" with your bucket variable name
[[r2_buckets]]
binding = "BUCKET"
bucket_name = "your-bucket-name"

# Environment variables (set these in Cloudflare dashboard or via wrangler secret)
# [vars]
# WEBDAV_USERNAME = "your-username"
# WEBDAV_PASSWORD = "your-password"
# WEBDAV_PUBLIC_READ = "0"

# Optional: Set subrequest limits for Workers
# [limits]
# subrequests = 1000
